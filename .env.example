# Core runtime
API_KEY=
API_SECRET=

# AI settings
AI_PROVIDER=gemini
# Supported values saat ini: gemini
GEMINI_API_KEY=
# Example:
# GEMINI_API_KEYS=key_backup_1,key_backup_2
# or:
# GEMINI_API_KEY_2=key_backup_1
# GEMINI_API_KEY_3=key_backup_2
GEMINI_API_KEYS=
# Optional backup keys can also be set as GEMINI_API_KEY_2, GEMINI_API_KEY_3, and so on.
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
AI_SIGNAL_FILTER_ENABLED=false
# Jika aktif, AI juga akan memeriksa rancangan OCO TP/SL sebelum order exit ditempatkan.
AI_SIGNAL_FILTER_FAIL_OPEN=false
AI_SIGNAL_MIN_CONFIDENCE=0.65
AI_SIGNAL_TIMEOUT_MS=12000
AI_SIGNAL_CACHE_TTL_MS=60000
AI_SIGNAL_MAX_OUTPUT_TOKENS=2000
AI_GRID_REVIEW_MIN_INTERVAL_MS=30000
# Cooldown per order yang sudah ditolak agar order yang sama tidak direview berulang-ulang.
AI_GRID_REJECT_COOLDOWN_MS=300000

# Dashboard
DASHBOARD_PORT=3000
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=

# Maintenance
CONFIG_AUTO_RELOAD_INTERVAL_MS=5000
